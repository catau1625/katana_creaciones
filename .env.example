# Copiar este archivo como .env y rellenar los valores.
# NUNCA commitear .env (ya está en .gitignore).

# --- Seguridad ---
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Base de datos (Supabase vía pooler Supavisor) ---
# Formato OBLIGATORIO:
#   - Una sola línea, sin comillas, sin espacios alrededor del '='
#   - Debe terminar en '/postgres'
#   - Host = pooler (...pooler.supabase.com), puerto 6543. NUNCA 5432 (IPv6-only en plan gratis)
#   - Si la contraseña tiene caracteres especiales (#, @, :, /, *, %), codificarla con urllib.parse.quote()
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Supabase SDK (opcional, solo si la app lo usa) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=sb_publishable_...

# --- Email (opcional en desarrollo) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
